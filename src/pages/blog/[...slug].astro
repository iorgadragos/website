---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import { publishedPosts, formatDate } from '../../lib/posts';
import { LINKS } from '../../consts';

export async function getStaticPaths() {
  const posts = publishedPosts(await getCollection('blog'));
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description} type="article">
  <div class="container">
    <article class="prose" style="padding-top:3rem">
      <p class="muted">{formatDate(post.data.pubDate)}</p>
      <h1>{post.data.title}</h1>
      <Content />
      <hr />
      <p class="muted">Enjoyed this? <a href={LINKS.substack}>Get the next one by email</a>.</p>
    </article>
    <Cta />
  </div>
</Base>
